{
  "name": "slipbox-datastar",
  "version": "1.0.0",
  "description": "Zettelkasten-style note-taking app built with Datastar framework",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun scripts/dev.js",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.873.0",
    "@aws-sdk/s3-request-presigner": "^3.873.0",
    "@kitajs/html": "^4.2.9",
    "@kitajs/ts-html-plugin": "^4.1.2",
    "@starfederation/datastar": "1.0.0-beta.11",
    "@starfederation/datastar-sdk": "1.0.0-RC.2",
    "@tigrisdata/core": "^1.3.0",
    "@types/express": "^5.0.3",
    "@types/marked": "^5.0.2",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.4",
    "express": "^5.1.0",
    "marked": "^16.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/bun": "latest",
    "playwright": "^1.55.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  }
}
