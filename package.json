{
  "name": "slipbox-datastar",
  "version": "1.0.0",
  "description": "Zettelkasten-style note-taking app built with Datastar framework",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun scripts/dev.js",
    "init": "./scripts/init.sh",
    "reset-datadir": "./scripts/reset-datadir.sh",
    "build:client": "bun scripts/build.js",
    "build": "bun run build:client && EMBED_ASSETS=true bun build src/index.ts --outdir dist --target bun",
    "build:mac": "NODE_ENV=production bun run build:client && NODE_ENV=production EMBED_ASSETS=true bun build src/index.ts --compile --outfile dist/slipbox-mac",
    "build:linux": "NODE_ENV=production bun run build:client && NODE_ENV=production EMBED_ASSETS=true bun build src/index.ts --compile --outfile dist/slipbox-linux --target=bun-linux-x64",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "git-clean": "./scripts/git-clean.sh",
    "clean:dist": "rm -rf dist",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:ci": "playwright test --reporter=list",
    "deploy": "bash scripts/deploy.sh",
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --organize-imports-enabled=false .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check": "biome check .",
    "check:apply": "biome check --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@kitajs/html": "^4.2.9",
    "@kitajs/ts-html-plugin": "^4.1.2",
    "@starfederation/datastar": "^1.0.0-beta.11",
    "@starfederation/datastar-sdk": "^1.0.0-beta.11",
    "@types/express": "^5.0.3",
    "@types/marked": "^5.0.2",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.4",
    "express": "^5.1.0",
    "marked": "^16.2.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@playwright/test": "^1.55.0",
    "@types/bun": "latest",
    "autoprefixer": "^10.4.21",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3",
    "typescript": "^5.9.2"
  }
}
