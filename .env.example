# Notes storage directory (defaults to ~/.slipbox-dev)
NOTES_DIR=

# Database path (defaults to NOTES_DIR/slipbox.db)
DATABASE_PATH=

# Server port
PORT=3000

# For development: use local file storage instead of Tigris
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=

# Tigris S3-compatible storage configuration (for production)
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_ACCESS_KEY_ID=your_access_key_id_here
TIGRIS_SECRET_ACCESS_KEY=your_secret_access_key_here
TIGRIS_BUCKET_NAME=slipbox-files